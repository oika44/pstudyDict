{
  "name": "pstudy-dict",
  "version": "0.6.0-beta.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "widget": "ng build && electron .",
    "dist:win": "ng build && electron-builder --win",
    "dist:win-installer": "ng build && electron-builder --win nsis portable",
    "dist:linux": "ng build && electron-builder --linux",
    "package": "sh portable/make-zip.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "encoding-japanese": "^2.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@types/encoding-japanese": "^2.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "main": "electron/main.mjs",
  "description": "P-Study 用 単語ファイル作成アプリ",
  "author": "oika",
  "build": {
    "appId": "jp.oika.pstudy-dict",
    "productName": "PStudyDict",
    "directories": {
      "output": "dist/widget"
    },
    "files": [
      "electron/**",
      "dist/pstudy-dict/browser/**",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "executableName": "pstudy-dict",
      "artifactName": "${productName}-Windows-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "P-Study 単語ファイル作成",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "pstudy-dict.exe"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Education",
      "maintainer": "oika"
    }
  }
}
